ENVIRONMENT=development
DEBUG=True

# Canonical PostgreSQL 16 connection string
DATABASE_URL=postgresql+psycopg://kanakku:kanakku_secret_123@localhost:5432/kanakku_prod

# Strictly enforce PostgreSQL — no silent fallback to SQLite
ALLOW_SQLITE_FALLBACK=False

SECRET_KEY=change_this_to_a_secure_random_32_character_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

DEFAULT_CURRENCY=INR
DEFAULT_CURRENCY_SYMBOL=₹
DEFAULT_PHONE_COUNTRY_CODE=+91
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
